# Copy to .env.local for local development. On Vercel, set these under
# Settings > Environment Variables. Never commit real values.

# Canonical site URL for metadata, sitemap.xml, cookies and CSRF.
NEXT_PUBLIC_SITE_URL=https://restorationmedical.ca

# Form destinations (clinic to confirm; see design/handoff/README.md "Form destinations").
# Each handler POSTs the JSON body to its endpoint and never stores or logs it.
# Leave unset in development to get a simulated success response.
# The booking endpoint answers 409 when the requested time is no longer free.
FORM_ENDPOINT_BOOK=
FORM_ENDPOINT_REGISTER=
FORM_ENDPOINT_CONTACT=
FORM_ENDPOINT_REFERRAL=
FORM_ENDPOINT_CAREERS=
FORM_ENDPOINT_RENEWAL=
FORM_ENDPOINT_TOKEN=
# Production forms with no endpoint answer "not connected" so patients are told to call.
# Set to 1 only on a demo deployment to fake a successful send.
FORM_SIMULATE=

# Analytics. Either a Tag Manager container or a GA4 measurement ID (Tag Manager wins if both).
# Prefer setting these in the admin: Site settings > Search defaults (no redeploy needed).
# Nothing loads until a visitor accepts the cookie banner, and never on form pages.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# Show the EN / Tiếng Việt toggle. Off until Vietnamese copy is ready.
NEXT_PUBLIC_VI_ENABLED=false

# Payload CMS (admin at /admin)
# Long random string, at least 32 characters: openssl rand -base64 48
# It also encrypts two-factor secrets, so changing it means everyone sets up two-factor again.
PAYLOAD_SECRET=
# Production database (Postgres on Neon). Unset locally to use ./data/payload.db (SQLite).
DATABASE_URL=
# Uploads in production (Vercel Blob). Unset locally to store under public/media.
BLOB_READ_WRITE_TOKEN=

# First admin account, used once by `npm run seed` (or by the build when SEED_ON_BUILD=1).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# On Vercel: set to 1 to fill an empty database from src/content during the build.
# Adds only what is missing; never overwrites edits made in the admin.
SEED_ON_BUILD=

# Two-factor sign-in for the admin is always on. Set to "off" only in an emergency
# (for example the only admin lost their phone) and remove it straight after.
ADMIN_2FA=

# Public URL of the clinic referral form PDF (for example /referral-form.pdf in public/). The download button is hidden until set.
NEXT_PUBLIC_REFERRAL_FORM_URL=
